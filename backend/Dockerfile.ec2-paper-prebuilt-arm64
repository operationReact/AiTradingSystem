# syntax=docker/dockerfile:1.7
# The exact SHA Java 21 JAR is built and tested on the GitHub x86 runner
# with the existing Maven dependency cache. Only the runtime uses ARM64.
# This prevents QEMU/Docker-stage Maven Central failures during EC2 release.
FROM eclipse-temurin:21-jre-jammy
ENV JAVA_TOOL_OPTIONS="-Xms128m -Xmx1024m -XX:ActiveProcessorCount=2 -Djava.security.egd=file:/dev/./urandom"
WORKDIR /app
RUN useradd --system --uid 10001 --create-home appuser
COPY target/ai-trading-system-0.1.0-SNAPSHOT.jar /app/app.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/app.jar"]
