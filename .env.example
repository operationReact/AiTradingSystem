# Local PostgreSQL
POSTGRES_DB=aitrading
POSTGRES_USER=aitrading
POSTGRES_PASSWORD=change_me_locally
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aitrading
SPRING_DATASOURCE_USERNAME=aitrading
SPRING_DATASOURCE_PASSWORD=change_me_locally

# AI news analysis (optional, backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provenance-aware RSS ingestion (opt-in; secrets remain backend-only)
NEWS_SUMMARIZATION_ENABLED=false
NEWS_INGESTION_ENABLED=false
NEWS_INGESTION_INTERVAL_MS=900000
NEWS_INGESTION_SOURCES=moneycontrol,economic-times
NEWS_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,ITC
NEWS_MAX_PAYLOAD_BYTES=1048576
NEWS_MAX_ITEMS_PER_SOURCE=50
NEWS_MAX_ARTICLES_PER_RUN=100
NEWS_MAX_SUMMARIES_PER_RUN=20
NEWS_RETENTION_DAYS=90
NEWS_API_TOKEN=
NEWS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Angel One SmartAPI (optional, backend only). Integration is not enabled by default.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Paper-only by default; live order placement is not implemented.
TRADING_MODE=PAPER
