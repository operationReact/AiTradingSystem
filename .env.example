# Local PostgreSQL
POSTGRES_DB=aitrading
POSTGRES_USER=aitrading
POSTGRES_PASSWORD=change_me_locally
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aitrading
SPRING_DATASOURCE_USERNAME=aitrading
SPRING_DATASOURCE_PASSWORD=change_me_locally

# AI news analysis (optional, backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Angel One SmartAPI (optional, backend only). Integration is not enabled by default.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Paper-only by default; live order placement is not implemented.
TRADING_MODE=PAPER
