              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "CheckExactPaperEC2AndSSMReadiness",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ssm:DescribeInstanceInformation",
