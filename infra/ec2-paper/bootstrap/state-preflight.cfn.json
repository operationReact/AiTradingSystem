                    "ssm:StartSession",
                    "iam:PassRole",
                    "iam:CreateRole",
                    "rds:CreateDBInstance",
                    "scheduler:UpdateSchedule",
                    "s3:DeleteObject",
                    "s3:DeleteBucket"
