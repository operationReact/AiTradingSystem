                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-south-1",
                      "ssm:resourceTag/Application": "ai-trading-system",
                      "ssm:resourceTag/Environment": "paper"
                    }
                  }
                },
                {
                  "Sid": "UploadOnlyShortLivedPaperReleaseAssets",
                  "Effect": "Allow",
